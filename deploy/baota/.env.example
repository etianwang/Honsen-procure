POSTGRES_URL=postgresql://honsen_api:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/honsen_procure
# Listener is fixed in index.js: 127.0.0.1:3000. HOST/PORT are not supported.
# Authentication uses PostgreSQL sessions + Node Argon2id; no JWT_SECRET setting.
# Optional COS configuration: provide all four values together; never commit secrets.
# COS_REGION=
# COS_BUCKET=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_SIGNED_URL_TTL_SECONDS=900
