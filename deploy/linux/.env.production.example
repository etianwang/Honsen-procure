# Copy only to /etc/honsen-procure/server.env (root:honsen-procure 0640).
# Replace placeholders locally; never place real values in a public site directory.
POSTGRES_URL=postgresql://RUNTIME_ROLE@127.0.0.1:5432/DATABASE_NAME
HOST=127.0.0.1
PORT=3000
COS_REGION=REPLACE_WITH_REGION
COS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
COS_SECRET_ID=REPLACE_LOCALLY
COS_SECRET_KEY=REPLACE_LOCALLY
COS_SIGNED_URL_TTL_SECONDS=900
