# Install as /etc/honsen-procure/server.env, root:root 0600.
# systemd reads this before switching to www. Never store it in the web root.
NODE_ENV=production
POSTGRES_URL=postgresql://honsen_procure_runtime:REPLACE_ME@127.0.0.1:5432/honsen_procure
# All four COS variables are required together; remove all four to disable COS.
COS_REGION=REPLACE_ME
COS_BUCKET=REPLACE_ME
COS_SECRET_ID=REPLACE_ME
COS_SECRET_KEY=REPLACE_ME
COS_SIGNED_URL_TTL_SECONDS=900
