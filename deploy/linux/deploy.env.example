# Example only. Copy to a root-owned mode-600 file outside the checkout.
# Do not use production passwords, addresses, or role names from this example.
DEPLOY_AUTHORIZED='no'
export PGHOST='DATABASE_HOST'
export PGPORT='5432'
export PGUSER='deploy_admin'
export PGDATABASE='DATABASE_NAME'
# Set PGPASSWORD in this protected file only if the approved credential method
# requires it. Configure the Node migration URL and libpq for the same primary.
POSTGRES_URL='postgresql://deploy_admin@DATABASE_HOST:5432/DATABASE_NAME'
OLD_ROLE='old_application_login'
NEW_ROLE='new_application_login'
RELEASE_DIR='/opt/honsen-procure/releases/REPLACE_ME'
RELEASE_SHA='REPLACE_WITH_40_HEX_COMMIT'
RELEASE_MANIFEST='/etc/honsen-procure/release-manifest.json'
RELEASE_MANIFEST_SHA256='REPLACE_WITH_INDEPENDENTLY_VERIFIED_64_HEX_DIGEST'
WRITER_INVENTORY='/etc/honsen-procure/writer-inventory.json'
BACKUP_DIR='/var/backups/honsen-procure'
EXTERNAL_BACKUP_DIR='/mnt/offsite/honsen-procure'
AUDIT_DIR='/var/log/honsen-procure-deploy'
RESTORE_SERVICE='honsen_restore_verifier'
PGSERVICEFILE='/etc/honsen-procure/pg_service.conf'
PGPASSFILE='/etc/honsen-procure/pgpass'
BACKUP_RETENTION_DAYS='REPLACE_WITH_APPROVED_DAYS'
BACKUP_RETENTION_POLICY='retain-all'
OFFSITE_STORAGE_ATTESTED='no'
NGINX_BIN='/usr/sbin/nginx'
NGINX_UNIT='nginx.service'
INGRESS_INCLUDE='/etc/honsen-procure/nginx-ingress.conf'
INGRESS_HOST='REPLACE_WITH_APPROVED_HOST'
INGRESS_PORT='443'
