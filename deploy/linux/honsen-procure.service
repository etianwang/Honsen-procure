[Unit]
Description=Honsen Procure API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/Honsen-procure/app/current/app
EnvironmentFile=/www/Honsen-procure/config/server.env
ExecStart=/www/Honsen-procure/app/current/app/node_modules/.bin/tsx /www/Honsen-procure/app/current/app/apps/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/Honsen-procure/uploads /www/Honsen-procure/logs

[Install]
WantedBy=multi-user.target
